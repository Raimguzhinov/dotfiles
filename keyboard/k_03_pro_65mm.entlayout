        {
          "index": 13,
          "name": "LG_SET_M1M2",
          "label": "RuEn\nM1M2",
          "title": "Set toggle language to Macro 1 for English layout and Macro 2 for Russian layout"
        },
        {
          "index": 14,
          "name": "LG_SET_DFLT",
          "label": "RuEn\nDflt",
          "title": "Set toggle language to default (Win+Space for PC and Ctrl+Space for Mac)"
        },
        {
